# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Local tooling
.claude/

# Generated outputs (regenerable via examples / paper build)
outputs/
paper/figures/*.png
paper/figures/results.json

# Quantitation baseline chunk intermediates (merged JSON is committed)
results/quantitation_baseline_part*.json
# Detectability spectrum chunk intermediates and regenerable plots
results/detectability_spectrum_part*.json
results/*.png
# Denoised-eval chunk intermediates; training checkpoint (weights are committed)
results/denoised_eval_part*.json
results/denoiser_checkpoint.pt
# D2 spectral-loss arm: main-run checkpoint and beta-selection debris
# (weights/logs are kept on disk as rejection evidence but not committed)
results/denoiser_d2_checkpoint.pt
results/denoiser_d2b*_checkpoint.pt
results/denoiser_d2b*_weights.pt
# Training data (publicly regenerable via tools/make_training_data.py)
data/training/

# Data (public datasets; fetch per docs/DATA.md, never commit).
# Root-anchored: a bare "data/" would also match pcctvmi/data/ and silently
# untrack the packaged spectrum/attenuation CSVs.
/data/

# Working temp
_tmp/

# OS
Thumbs.db
.DS_Store

# chunked run intermediates (merged JSON is committed)
results/*_part*.json
# Walnut noise-model chunk intermediates (merged npz/json are committed)
results/walnut_noise_model_*_part*.npz
